{
  "scripts": {
    "complete": "tsx solutions_ts/$npm_config_task/answer.ts < solutions_ts/$npm_config_task/input.txt",
    "lint": "oxlint solutions_ts",
    "format": "oxfmt --write solutions_ts package.json .oxlintrc.json .oxfmtrc.json",
    "format:check": "oxfmt --check solutions_ts package.json .oxlintrc.json .oxfmtrc.json"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
